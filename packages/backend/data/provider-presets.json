      "suggestedProviderId": "openai",
      "suggestedName": "OpenAI",
      "apiBaseUrl": {
        "chat": "https://api.openai.com/v1",
        "completions": "https://api.openai.com/v1",
        "responses": "https://api.openai.com/v1",
        "embeddings": "https://api.openai.com/v1",
        "transcriptions": "https://api.openai.com/v1",
        "speech": "https://api.openai.com/v1"
      },
      "piAiProvider": "openai",
      "autoCompat": true
    },
    {
      "id": "anthropic",
